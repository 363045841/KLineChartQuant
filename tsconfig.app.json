{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "packages/**/*.vue"],
  "exclude": [
    "**/__tests__/**",
    "**/__bench__/**",
    "**/node_modules",
    "**/dist",
    "**/out",
    "**/*.config.*"
  ],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ESNext",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "paths": {
      "@/core/*": ["./packages/core/src/engine/*"],
      "@/types/*": ["./packages/core/src/foundation/types/*"],
      "@/plugin": ["./packages/core/src/foundation/plugin"],
      "@/utils/*": ["./packages/core/src/foundation/utils/*"],
      "@/*": ["./packages/core/src/*"],
      "@363045841yyt/klinechart-agent-runtime": [
        "./packages/agent-runtime/src/index.ts"
      ],
      "@363045841yyt/klinechart-agent-runtime/contracts/ui": [
        "./packages/agent-runtime/src/contracts/ui.ts"
      ]
    },
    "plugins": [{ "name": "@effect/language-service/tsconfig-plugin" }],
    "types": ["vite/client", "unplugin-icons/types/vue"]
  }
}
