{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // 工作区与 Expo 的声明文件会向上解析到根目录的另一份 @types/react；统一到本应用的版本。
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist-export"]
}
