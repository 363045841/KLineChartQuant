{
  "name": "@363045841yyt/klinechart-script-editor",
  "version": "0.11.0-alpha.10",
  "description": "Standalone script editor page for KLineChartQuant: the detached editor window bundle, published separately so Apache-2.0 chart packages never inline AGPL code.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/363045841/KLineChartQuant.git"
  },
  "bugs": "https://github.com/363045841/KLineChartQuant/issues",
  "homepage": "https://363045841.github.io/KLineChartQuant/",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-page.mjs && tsc -p tsconfig.build.json",
    "test": "node --test scripts/test-editor-page.mjs",
    "prepublishOnly": "pnpm build",
    "lint:publish": "publint --strict ."
  },
  "devDependencies": {
    "@363045841yyt/klinechart": "workspace:*",
    "@363045841yyt/klinechart-core": "workspace:*",
    "@363045841yyt/klinechart-script": "workspace:*",
    "@363045841yyt/klinechart-script-server": "workspace:*",
    "@babel/core": "^8.0.5",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/plugin-transform-typescript": "^8.0.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "publint": "^0.3.25",
    "typescript": "~6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.4",
    "vite-plugin-babel": "^1.7.3",
    "vue": "^3.5.44",
    "@fontsource/jetbrains-mono": "^5.3.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
