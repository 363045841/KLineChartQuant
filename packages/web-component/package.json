    "@363045841yyt/klinechart-script-server": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@363045841yyt/klinechart-script-server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@363045841yyt/klinechart-core": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.10",
    "publint": "^0.3.25",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.4",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vue": "^3.5.44"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
