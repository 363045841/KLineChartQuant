{
  "name": "@363045841yyt/klinechart-web-component",
  "private": true,
  "version": "0.11.0-alpha.10",
  "description": "Standalone Web Component build of KLineChartQuant: one ESM file that registers the full-UI <kline-chart> custom element for non-Vue hosts.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/363045841/KLineChartQuant.git"
  },
  "bugs": "https://github.com/363045841/KLineChartQuant/issues",
  "homepage": "https://363045841.github.io/KLineChartQuant/",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.d.ts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "pnpm build",
