{
  "name": "@363045841yyt/klinechart-agent-runtime",
  "version": "0.11.0-alpha.5",
  "description": "Framework-neutral Pi agent runtime, durable sessions, and typed host contracts for KLineChartQuant.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/363045841/KLineChartQuant.git"
  },
  "bugs": "https://github.com/363045841/KLineChartQuant/issues",
  "homepage": "https://363045841.github.io/KLineChartQuant/",
  "type": "module",
  "sideEffects": [
    "./dist/tools/code-interpreter/index.js",
    "./dist/tools/code-interpreter/tool.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./contracts/ui": {
      "types": "./dist/contracts/ui.d.ts",
      "import": "./dist/contracts/ui.js"
    },
    "./code-interpreter": {
      "types": "./dist/tools/code-interpreter/index.d.ts",
      "import": "./dist/tools/code-interpreter/index.js"
    },
    "./code-interpreter/cloud-run": {
      "types": "./dist/tools/code-interpreter/providers/cloud-run-sandbox-provider.d.ts",
      "import": "./dist/tools/code-interpreter/providers/cloud-run-sandbox-provider.js"
    },
    "./code-interpreter/fly": {
      "types": "./dist/tools/code-interpreter/providers/fly-machines-provider.d.ts",
      "import": "./dist/tools/code-interpreter/providers/fly-machines-provider.js"
    },
    "./code-interpreter/local": {
      "types": "./dist/tools/code-interpreter/providers/local-provider.d.ts",
      "import": "./dist/tools/code-interpreter/providers/local-provider.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "coverage": "vitest run --coverage",
    "lint:publish": "publint --strict .",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@363045841yyt/klinechart-core": "workspace:*",
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-session-backend-sqlite-node": "^0.85.1",
    "typebox": "^1.3.33"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^25.9.6",
    "publint": "^0.3.21",
    "typescript": "~6.0.3",
    "vite-plugin-babel": "^1.3.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
