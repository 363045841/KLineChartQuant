{
  "name": "@363045841yyt/klinechart-agent-runtime",
  "version": "0.1.0",
  "description": "Framework-neutral Pi agent runtime, durable sessions, and typed host contracts for KLineChartQuant.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./contracts/ui": {
      "types": "./dist/contracts/ui.d.ts",
      "import": "./dist/contracts/ui.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "coverage": "vitest run --coverage",
    "lint:publish": "publint --strict .",
    "live:302ai": "pnpm build && node scripts/evaluate-302ai.mjs",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-session-backend-sqlite-node": "0.84.2",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "publint": "^0.3.21",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
