{
  "extends": "@tsconfig/node26/tsconfig.json",
  "compilerOptions": {
    // @tsconfig/node26 基座不再设置 strict，Electron 主进程侧需显式开启。
    "strict": true,
    "composite": true,
    "outDir": "./out",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["electron-vite/node"]
  },
  "include": ["electron/**/*.ts", "vite.config.ts"]
}
