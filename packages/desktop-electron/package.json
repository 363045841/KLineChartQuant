{
  "name": "@363045841yyt/klinechart-desktop",
  "version": "0.11.1-alpha.0",
  "private": true,
  "description": "Electron desktop shell for @363045841yyt/klinechart",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm build:backends && electron-vite build && electron-builder",
    "build:unpack": "pnpm build:backends && electron-vite build && electron-builder --dir",
    "build:backends": "node ../../scripts/build-backends.mjs",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --build",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@363045841yyt/klinechart-script-chart": "workspace:*",
    "@363045841yyt/klinechart-script-server": "workspace:*",
    "@363045841yyt/klinechart": "workspace:*",
    "@363045841yyt/klinechart-agent-runtime": "workspace:*",
    "@363045841yyt/klinechart-core": "workspace:*"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^31.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.1.0",
    "vitest": "^5.0.0",
    "vue": "^3.5.42"
  }
}
