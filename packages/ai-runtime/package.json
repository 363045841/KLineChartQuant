{
  "name": "@363045841yyt/klinechart-ai-runtime",
  "version": "0.0.0",
  "description": "AI Native runtime for @363045841yyt/klinechart — MCP tool schemas, controller describe() output, chart state serialization.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp-server": {
      "types": "./dist/mcpServer.d.ts",
      "import": "./dist/mcpServer.js"
    },
    "./create-with-mcp": {
      "types": "./dist/createWithMcp.d.ts",
      "import": "./dist/createWithMcp.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "start": "node --experimental-transform-types scripts/dev.ts",
    "test": "vitest run",
    "inspect": "npx @modelcontextprotocol/inspector node --experimental-transform-types scripts/dev.ts"
  },
  "peerDependencies": {
    "@363045841yyt/klinechart-core": "workspace:*"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1",
    "ws": "^8"
  },
  "devDependencies": {
    "@types/ws": "^8",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
