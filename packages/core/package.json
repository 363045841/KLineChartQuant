{
  "name": "@363045841yyt/klinechart-core",
  "version": "0.11.0-alpha.9",
  "description": "Headless K-line chart engine + reactive controllers. Zero framework dependencies.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/363045841/KLineChartQuant.git"
  },
  "bugs": "https://github.com/363045841/KLineChartQuant/issues",
  "homepage": "https://363045841.github.io/KLineChartQuant/",
  "type": "module",
  "sideEffects": [
    "./src/data/**/*.ts",
    "./dist/data/**/*.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reactivity": {
      "types": "./dist/foundation/reactivity/index.d.ts",
      "import": "./dist/foundation/reactivity/index.js"
    },
    "./persistence": {
      "types": "./dist/foundation/persistence/index.d.ts",
      "import": "./dist/foundation/persistence/index.js"
    },
    "./persistence-scope": {
      "types": "./dist/foundation/persistence/persistence-scope.d.ts",
      "import": "./dist/foundation/persistence/persistence-scope.js"
    },
    "./controllers": {
      "types": "./dist/controllers/index.d.ts",
      "import": "./dist/controllers/index.js"
    },
    "./agent-tools": {
      "types": "./dist/foundation/agent/chartToolRegistry.d.ts",
      "import": "./dist/foundation/agent/chartToolRegistry.js"
    },
    "./agent": {
      "types": "./dist/features/agent/index.d.ts",
      "import": "./dist/features/agent/index.js"
    },
    "./market-data": {
      "types": "./dist/data/provider/index.d.ts",
      "import": "./dist/data/provider/index.js"
    },
    "./market-data/sources": {
      "types": "./dist/data/provider/impl/sources/index.d.ts",
      "import": "./dist/data/provider/impl/sources/index.js"
    },
    "./market-data/sources/*": {
      "types": "./dist/data/provider/impl/sources/*.d.ts",
      "import": "./dist/data/provider/impl/sources/*.js"
    },
    "./plugin": {
      "types": "./dist/foundation/plugin/index.d.ts",
      "import": "./dist/foundation/plugin/index.js"
    },
    "./config": {
      "types": "./dist/foundation/config/chartSettings.d.ts",
      "import": "./dist/foundation/config/chartSettings.js"
    },
    "./input": {
      "types": "./dist/features/input/index.d.ts",
      "import": "./dist/features/input/index.js"
    },
    "./types/price": {
      "types": "./dist/foundation/types/price.d.ts",
      "import": "./dist/foundation/types/price.js"
    },
    "./engine/chart": {
      "types": "./dist/engine/chart/index.d.ts",
      "import": "./dist/engine/chart/index.js"
    },
    "./engine/utils/zoom": {
      "types": "./dist/engine/viewport/zoom.d.ts",
      "import": "./dist/engine/viewport/zoom.js"
    },
    "./engine/utils/klineConfig": {
      "types": "./dist/engine/viewport/klineConfig.d.ts",
      "import": "./dist/engine/viewport/klineConfig.js"
    },
    "./engine/renderers/Indicator": {
      "types": "./dist/engine/renderers/Indicator/index.d.ts",
      "import": "./dist/engine/renderers/Indicator/index.js"
    },
    "./indicators": {
      "types": "./dist/engine/indicators/indicatorDefinitionRegistry.d.ts",
      "import": "./dist/engine/indicators/indicatorDefinitionRegistry.js"
    },
    "./engine/renderers/Indicator/indicatorCatalog": {
      "types": "./dist/engine/renderers/Indicator/indicatorCatalog.d.ts",
      "import": "./dist/engine/renderers/Indicator/indicatorCatalog.js"
    },
    "./engine/controller/interaction": {
      "types": "./dist/engine/controller/interaction.d.ts",
      "import": "./dist/engine/controller/interaction.js"
    },
    "./engine/marker/registry": {
      "types": "./dist/engine/marker/registry.d.ts",
      "import": "./dist/engine/marker/registry.js"
    },
    "./engine/drawing": {
      "types": "./dist/engine/drawing/index.d.ts",
      "import": "./dist/engine/drawing/index.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "import": "./dist/version.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "version": "node -e \"require('fs').writeFileSync('src/version.ts', 'export const VERSION = ' + JSON.stringify(require('./package.json').version) + '\\\\n')\" && git add src/version.ts",
    "build": "node ../../scripts/generate-indicator-entrypoints.mjs && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit",
    "lint:publish": "publint --strict ."
  },
  "size-limit": [
    {
      "name": "core (entry, pre-build src measurement)",
      "path": "src/index.ts",
      "limit": "30 KB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/jsdom": "^30.0.0",
    "@webgpu/types": "^0.1.72",
    "colorjs.io": "0.5.2",
    "culori": "4.0.2",
    "fake-indexeddb": "^6.2.5",
    "publint": "^0.3.0",
    "size-limit": "^12.1.0",
    "style-dictionary": "5.6.0",
    "typescript": "~6.0.3",
    "vite-plugin-babel": "^1.3.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@iconify-icons/tabler": "^2.0.3",
    "typebox": "1.3.33"
  }
}
