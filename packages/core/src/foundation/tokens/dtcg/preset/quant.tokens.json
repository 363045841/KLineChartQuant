      },
      "accent": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [0.3569, 0.3098, 0.7333], "hex": "#5B4FBB" }
      },
      "onAccent": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" }
      },
      "gridMajor": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [0.851, 0.8706, 0.9137], "hex": "#D9DEE9" }
      },
      "gridMinor": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [0.9137, 0.9255, 0.9529], "hex": "#E9ECF3" }
      }
    },
    "color": {
      "selectionFill": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.3569, 0.3098, 0.7333],
          "alpha": 0.149,
          "hex": "#5B4FBB"
        },
        "$description": "= visual.accent at alpha 0x26."
      },
      "ma": {
        "$description": "常用指标消费已有十色分类色盘，避免仅在预览色样体现差异。",
        "ma5": { "$type": "color", "$value": "{light.color.palette.i1}" },
        "ma10": { "$type": "color", "$value": "{light.color.palette.i2}" },
        "ma20": { "$type": "color", "$value": "{light.color.palette.i3}" },
        "ma30": { "$type": "color", "$value": "{light.color.palette.i4}" },
        "ma60": { "$type": "color", "$value": "{light.color.palette.i8}" }
      },
      "boll": {
        "upper": { "$type": "color", "$value": "{light.color.palette.i5}" },
        "middle": { "$type": "color", "$value": "{light.color.palette.i6}" },
        "lower": { "$type": "color", "$value": "{light.color.palette.i8}" }
      },
      "avwapLine": { "$type": "color", "$value": "{light.color.palette.i8}" },
      "avwapBand": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4863, 0.2275, 0.9294],
          "alpha": 0.149,
          "hex": "#7C3AED"
        },
        "$description": "= color.palette.i8 at alpha 0x26."
      },
      "mtfOverlay": { "$type": "color", "$value": "{light.color.palette.i6}" }
    }
  },
