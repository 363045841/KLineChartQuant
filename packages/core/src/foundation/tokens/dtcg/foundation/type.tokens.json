    "$description": "Type scale (craft-principles §4.2; design §3.3). Tracking tightens as size grows (CP 17); label and copy are different roles (CP 18). 10px is removed; 11px is allowed only for mono/tabular contexts (axis ticks, meta). Weights: 400 at 12-16 and 600 at ≥20 per CP §4.2. Geist Sans/Mono are the target families (design §2.4); families are not tokenised here because canvas fonts (fonts.ts) are frozen (ADR 0005).",
    "$extensions": {
      "io.github.363045841.kcq": {
        "keywords": {
          "numeric": "tabular-nums"
        },
        "keywordDescriptions": {
          "numeric": "Default font-variant-numeric for all numeric UI: prices, tables, axes, timers (CP 19; S1, S27; ADR 0004). Emitted as --klc-text-numeric."
        }
      }
    },
    "11Mono": {
      "$description": "Axis ticks, dense meta: mono/tabular only. Basis: Geist mono labels (S4); Inter dynmetrics +0.005em ≈ 0 (S22). Weight 400 of CP §4.2's 400-500.",
      "fontFamily": { "$type": "fontFamily", "$value": "{typography.fontFamilyMono}" },
      "fontSize": { "$type": "dimension", "$value": { "value": 11, "unit": "px" } },
      "lineHeight": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
      "letterSpacing": {
        "$type": "number",
        "$value": 0,
        "$extensions": { "io.github.363045841.kcq": { "unit": "em" } }
      },
      "fontWeight": { "$type": "fontWeight", "$value": 400 }
    },
