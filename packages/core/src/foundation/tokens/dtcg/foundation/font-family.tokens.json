{
  "fontFamily": {
    "$description": "随包字体按用途提供字体栈，缺字时使用对应的回退字体。",
    "ui": {
      "$type": "fontFamily",
      "$value": ["HarmonyOS Sans", "system-ui", "sans-serif"]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "Liberation Mono", "monospace"]
    },
    "brand": {
      "$type": "fontFamily",
      "$value": ["Outfit", "sans-serif"],
      "$description": "品牌字体：截图水印品牌字与图表左上角角标。随包提供 latin-600（@fontsource/outfit）。"
    },
    "brandCjk": {
      "$type": "fontFamily",
      "$value": ["HarmonyOS Sans", "sans-serif"],
      "$description": "品牌字的中文回退：截图水印里的中文品种名。随包提供 HarmonyOS_Sans_SC_Medium.ttf（Medium 500）。"
    }
  },
  "fontWeight": {
    "$description": "每个字体角色只请求随包发布的原生字重。",
    "ui": { "$type": "fontWeight", "$value": 500 },
    "mono": { "$type": "fontWeight", "$value": 400 },
    "brand": { "$type": "fontWeight", "$value": 600 },
    "brandCjk": { "$type": "fontWeight", "$value": "{fontWeight.ui}" }
  }
}
