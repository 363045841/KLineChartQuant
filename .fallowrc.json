{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/core/src/index.ts",
    "packages/core/src/engine/state/index.ts",
    "packages/vue/src/index.ts",
    "packages/react/src/index.ts",
    "packages/angular/src/index.ts"
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/out/**",
    "**/node_modules/**",
    "**/__bench__/**",
    "components.d.ts",
    "**/*.tsbuildinfo",
    "**/coverage/**",
    "**/preview/dist/**",
    "packages/core/design-tokens/**",
    "packages/react/preview/**",
    "scripts/lint/stylelint-plugin-klc.mjs"
  ],
  "ignoreDependencies": ["~icons", "postcss-html"],
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "warn",
    "unused-dependencies": "warn",
    "css-dead-surface": "off",
    "css-selector-complexity": "off"
  },
  "duplicates": {
    "ignorePatterns": ["**/__tests__/**"]
  }
}
