{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/core/src/index.ts",
    "packages/core/src/engine/state/index.ts",
    "packages/vue/src/index.ts",
    "packages/react/src/index.ts",
    "packages/angular/src/index.ts",
    "packages/vue/preview/main.ts",
    "packages/script/src/quickjs/runtime/indicator.ts"
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/out/**",
    "**/node_modules/**",
    "**/__bench__/**",
    "components.d.ts",
    "**/*.tsbuildinfo",
    "**/coverage/**",
    "**/preview/dist/**",
    "packages/core/design-tokens/**",
    "packages/react/preview/**",
    "scripts/lint/stylelint-plugin-klc.mjs"
  ],
  "ignoreDependencies": ["~icons", "postcss-html", "@arethetypeswrong/cli"],
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "warn",
    "unused-dependencies": "warn",
    "boundary-violation": "error",
    "policy-violation": "off",
    "css-dead-surface": "off",
    "css-selector-complexity": "off"
  },
  "rulePacks": [],
  "boundaries": {
    "zones": [
      { "name": "plot-contracts", "patterns": ["packages/plot-contracts/**"] },
      { "name": "script", "patterns": ["packages/script/**"] },
      { "name": "core", "patterns": ["packages/core/**"] },
      { "name": "script-chart", "patterns": ["packages/script-chart/**"] },
      { "name": "agent-runtime", "patterns": ["packages/agent-runtime/**"] },
      { "name": "vue", "patterns": ["packages/vue/**"] },
      { "name": "react", "patterns": ["packages/react/**"] },
      { "name": "angular", "patterns": ["packages/angular/**"] },
      { "name": "mobile", "patterns": ["packages/mobile/**"] },
      { "name": "desktop-electron", "patterns": ["packages/desktop-electron/**"] },
      { "name": "examples", "patterns": ["examples/**"] }
    ],
    "rules": [
      { "from": "plot-contracts", "allow": [] },
      { "from": "script", "allow": ["plot-contracts"] },
      { "from": "core", "allow": ["plot-contracts"] },
      { "from": "script-chart", "allow": ["plot-contracts", "script", "core"] },
      { "from": "agent-runtime", "allow": ["core"] },
      { "from": "vue", "allow": ["core", "script", "script-chart", "agent-runtime"] },
      { "from": "react", "allow": ["core", "vue"] },
      { "from": "angular", "allow": ["core"] },
      { "from": "mobile", "allow": ["core", "react"] },
      { "from": "desktop-electron", "allow": ["core", "script-chart", "agent-runtime", "vue"] },
      {
        "from": "examples",
        "allow": [
          "plot-contracts",
          "script",
          "script-chart",
          "core",
          "agent-runtime",
          "vue",
          "react",
          "angular"
        ]
      }
    ]
  },
  "duplicates": {
    "ignorePatterns": ["**/__tests__/**"]
  }
}
