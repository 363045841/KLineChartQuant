{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "ts-mcp-server": {
        "type": "local",
        "command": ["ts-mcp-server"]
      },
      "codegraph": {
        "type": "local",
        "command": ["codegraph", "serve", "--mcp"]
      }
    }
  },
  "agents": {
    "explore": {
      "permissions": [
        { "action": "execute", "resource": "*", "effect": "allow" },
        {
          "action": "codegraph_codegraph_explore",
          "resource": "*",
          "effect": "allow"
        }
      ]
    }
  }
}
