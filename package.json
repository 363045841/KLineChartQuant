{
  "name": "klinechart-monorepo",
  "version": "0.7.1",
  "description": "A lightweight financial K-line charting library with first-class AI Agent support, crisp ResizeObserver-driven rendering, and plugin-based architecture. Focused on quantitative trading scenarios with TradingView-level interaction experience.",
  "author": "363045841 <slslswbsy@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/363045841/KLineChartQuant.git"
  },
  "bugs": "https://github.com/363045841/KLineChartQuant/issues",
  "homepage": "https://363045841.github.io/KLineChartQuant/",
  "keywords": [
    "kline-chart",
    "plugin-architecture",
    "webgl",
    "high-performance",
    "ai",
    "crisp-rendering",
    "sharp-rendering",
    "agent",
    "ai-chart",
    "modern-ui",
    "device-pixel-ratio",
    "candlestick-chart",
    "financial-chart",
    "tradingview",
    "canvas",
    "rendering-engine",
    "resizeobserver",
    "device-pixel-content-box",
    "drawing-tools",
    "chart-drawing",
    "trend-line",
    "fibonacci",
    "pixel-perfect",
    "responsive",
    "visualization",
    "quantitative-trading",
    "technical-analysis",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup-backends.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:lan": "node scripts/dev.mjs --lan",
    "dev:all": "node scripts/dev.mjs -c all",
    "dev:g": "node scripts/dev.mjs -c gotdx",
    "dev:b": "node scripts/dev.mjs -c baostock",
    "dev:bnb": "node scripts/dev.mjs -c binance",
    "dev:lan:all": "node scripts/dev.mjs --lan -c all",
    "connecter": "node scripts/start-connecter.mjs",
    "build": "pnpm build:packages",
    "build:packages": "pnpm --filter @363045841yyt/klinechart-core build && pnpm --filter @363045841yyt/klinechart-agent-runtime build && pnpm --filter @363045841yyt/klinechart build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "pnpm --filter @363045841yyt/klinechart preview",
    "preview:demo": "vite preview --config vite.demo.config.ts",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.vitest.json",
    "test:unit": "vitest",
    "test:packages": "pnpm -r test",
    "docs:generate": "node scripts/generate-readmes.mjs",
    "docs:check": "node scripts/generate-readmes.mjs --check",
    "size:packages": "pnpm -r --workspace-concurrency=4 size",
    "lint:publish": "pnpm -r --workspace-concurrency=4 lint:publish",
    "lint:types": "node scripts/lint-types.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.7",
    "@biomejs/biome": "2.5.13",
    "@iconify-json/tabler": "^1.2.38",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "markdown-it": "^15.0.0",
    "npm-run-all2": "^8.0.4",
    "pdf-lib": "^1.17.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.12",
    "typedoc": "^0.28.19",
    "typescript": "~6.0.3",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.1",
    "vite-plugin-babel": "^1.7.3",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.9"
  }
}
