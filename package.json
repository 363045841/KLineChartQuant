{
  "name": "klinechart-monorepo",
  "version": "0.7.1",
  "description": "A lightweight financial K-line charting library with first-class AI Agent support, crisp ResizeObserver-driven rendering, and plugin-based architecture. Focused on quantitative trading scenarios with TradingView-level interaction experience.",
  "author": "363045841 <slslswbsy@qq.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/363045841/KLineChartQuant.git"
  },
  "bugs": "https://github.com/363045841/KLineChartQuant/issues",
  "homepage": "https://363045841.github.io/KLineChartQuant/",
  "keywords": [
    "kline-chart",
    "plugin-architecture",
    "webgl",
    "high-performance",
    "ai",
    "crisp-rendering",
    "sharp-rendering",
    "agent",
    "ai-chart",
    "modern-ui",
    "device-pixel-ratio",
    "candlestick-chart",
    "financial-chart",
    "tradingview",
    "canvas",
    "rendering-engine",
    "resizeobserver",
    "device-pixel-content-box",
    "drawing-tools",
    "chart-drawing",
    "trend-line",
    "fibonacci",
    "pixel-perfect",
    "responsive",
    "visualization",
    "quantitative-trading",
    "technical-analysis",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.11.0"
  },
  "scripts": {
    "indicators:generate": "node scripts/generate-indicator-entrypoints.mjs",
    "indicators:check": "node scripts/generate-indicator-entrypoints.mjs --check",
    "test:indicator-generation": "pnpm --filter @363045841yyt/klinechart-core... build && node --test scripts/__tests__/generate-indicator-entrypoints.test.mjs",
    "setup:backends": "node scripts/setup-backends.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:lan": "node scripts/dev.mjs --lan",
    "dev:all": "node scripts/dev.mjs -c all",
    "dev:g": "node scripts/dev.mjs -c gotdx",
    "dev:b": "node scripts/dev.mjs -c baostock",
    "dev:bnb": "node scripts/dev.mjs -c binance",
    "dev:mt5": "node scripts/dev.mjs -c mt5",
    "dev:ths": "node scripts/dev.mjs -c ths",
    "dev:lan:all": "node scripts/dev.mjs --lan -c all",
    "connector": "node scripts/start-connector.mjs",
    "build": "pnpm build:packages",
    "build:packages": "pnpm --filter @363045841yyt/klinechart-plot-contracts build && pnpm --filter @363045841yyt/klinechart-script build && pnpm --filter @363045841yyt/klinechart-script-server build && pnpm --filter @363045841yyt/klinechart-core build && pnpm --filter @363045841yyt/klinechart-script-chart build && pnpm --filter @363045841yyt/klinechart-agent-runtime build && pnpm --filter @363045841yyt/klinechart build",
    "build:demo": "vite build --config packages/vue/preview/vite.config.ts",
    "preview": "pnpm --filter @363045841yyt/klinechart preview",
    "preview:demo": "vite preview --config packages/vue/preview/vite.config.ts",
    "type-check": "pnpm type-check:src && pnpm type-check:tests",
    "type-check:src": "pnpm indicators:generate && vue-tsc --noEmit -p packages/script/tsconfig.runtime.json && vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "type-check:tests": "vue-tsc --noEmit -p tsconfig.vitest.json",
    "test:unit": "vitest",
    "test:packages": "pnpm -r test",
    "test:scripts": "node --test scripts/__tests__/rolldown-thread-env.test.mjs scripts/__tests__/vite-dev.test.mjs",
    "bench": "node bench/run.mjs",
    "bench:1080p": "node bench/run.mjs --resolutions=1080p",
    "bench:2k": "node bench/run.mjs --resolutions=2k",
    "bench:report": "node bench/report.mjs",
    "docs:generate": "node scripts/generate-readmes.mjs && pnpm docs:script:generate",
    "docs:check": "node scripts/generate-readmes.mjs --check && pnpm docs:script:check",
    "docs:script:generate": "node packages/script/scripts/generate-api-docs.mjs",
    "docs:script:check": "node packages/script/scripts/generate-api-docs.mjs --check",
    "tokens:build": "node packages/core/scripts/tokens/build.mjs",
    "tokens:check": "node packages/core/scripts/tokens/build.mjs --check",
    "tokens:palettes": "node packages/core/scripts/tokens/generate-palettes.mjs",
    "tokens:contrast": "tsx packages/core/scripts/tokens/contrast-report.mts",
    "size:packages": "pnpm -r --workspace-concurrency=4 size",
    "lint:publish": "pnpm -r --workspace-concurrency=4 lint:publish",
    "license:boundary": "node scripts/check-license-boundary.mjs",
    "lint:types": "node scripts/lint-types.mjs",
    "lint": "biome check .",
    "script:run": "tsx scripts/run-script.mts",
    "lint:ui": "stylelint \"packages/vue/src/**/*.{vue,css}\"",
    "lint:ui:prune": "stylelint \"packages/vue/src/**/*.{vue,css}\" --suppress",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/plugin-transform-typescript": "^8.0.5",
    "@biomejs/biome": "^2.5.15",
    "@iconify-json/tabler": "^1.2.41",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.2",
    "npm-run-all2": "^8.0.4",
    "postcss-html": "2.0.0",
    "stylelint": "17.16.0",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "unplugin-icons": "^24.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vite-plugin-babel": "^1.7.3",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
