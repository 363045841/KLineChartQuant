# KCQ 分析采集器 · 配置模板
#
# 这是采集器全部配置项的唯一事实来源：所有部署形态（本机、Linux 主机、容器、云 VM）
# 都读同一套 `KCQ_*` 环境变量，差异只在"谁来读这个文件"。
#
# 三种读法：
#   - Linux 主机 / 云 VM：复制到 /etc/kcq/collector.env，由 systemd 的 EnvironmentFile 读入。
#   - Docker：复制到部署目录的 .env，docker compose 把它转成容器环境变量。
#   - 本机一次性运行：shell 里 `set -a; . collector.env; set +a` 之后再执行采集命令。
#
# 规则：
#   1. 只写 `KEY=VALUE` 行，不带 export。# 开头是注释，空值表示"用脚本里的默认值"。
#   2. 凭据（代理账号、API key）一律不写这里，走宿主密钥或进程环境注入。
#   3. 改配置改这里；collector.sh 里的同名默认值只是兜底，不要在脚本里调参数。

# ---- 必填 ----
# 数据根目录：分片和日志都写到这里（日志在 <数据根>/logs）。
# 换宿主只改这一行；实例的实际取值记在 deploy/instances/<名字>.env。
KCQ_DATA_ROOT=/srv/kcq/analytics

# ---- 代理 ----
# 直连能通就两个都留空。给了就必须同时给主机和端口，否则采集器以退出码 2 拒绝启动。
# 容器里不能用 127.0.0.1 指代宿主机（那是容器自己）。
KCQ_PROXY_HOST=
KCQ_PROXY_PORT=

# ---- 循环与节奏（秒，正整数）----
# 期权聚合位：60 秒一轮，与面板轮询一致。
KCQ_OPTION_INTERVAL=60
# 买卖量：跟 K 线刷新走，5 分钟一轮足够。
KCQ_VOLUME_INTERVAL=300
# 订单流面板快照（五家交易所深度/成交/持仓）。
KCQ_ORDERFLOW_INTERVAL=60
# 逐笔成交：单次只能取 1000 笔，间隔太长会漏笔，保持 10 秒。
KCQ_TRADES_INTERVAL=10

# ---- 期权原始链采样（分钟）----
# 只有落在采样分钟的轮次才落全链，其余轮次只写聚合位。默认 5 分钟，
# 单品种约 5–6.5MB/天；设为 1 即每分钟落一次（约 20MB/天/品种）。
KCQ_CHAIN_EVERY=5

# ---- 品种 ----
# 期权标的：BTC/ETH 走 Deribit，SOL/BNB/XRP 走 Binance。没登记期权的品种会被跳过。
KCQ_CURRENCIES=BTC,ETH,SOL,BNB,XRP
# 买卖量交易对。
KCQ_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT
# 订单流与逐笔的交易对（越少越省配额）。
KCQ_ORDERFLOW_SYMBOLS=BTCUSDT,ETHUSDT
KCQ_ORDERFLOW_VENUES=binance,okx,bybit,bitget,hyperliquid
# OKX 不提供逐笔成交流，默认不含它。
KCQ_TRADES_VENUES=binance,bybit,bitget,hyperliquid

# ---- 进程 ----
# 本进程负责哪些循环：一台机器只跑一份采集时保持四个全跑。
# 宿主机单独补跑订单流时用 KCQ_WORKERS=orderflow,trades，避免与容器里的采集重复写同一份分片。
KCQ_WORKERS=options,volume,orderflow,trades
# Node 可执行文件；留空用 PATH 里的 node。群晖等找不到 node 的环境填绝对路径。
KCQ_NODE_BIN=
# 采集器产物路径；留空用 collector.sh 同级的 dist/collector.mjs。
KCQ_BUNDLE=
