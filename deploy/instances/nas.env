# 线上实例：群晖 NAS（Docker，容器 kcq-collector）
#
# 这份文件是 NAS 上 /volume1/docker/kcq/app/.env 的版本库副本，只记录非机密配置：
# 主机路径、代理地址、循环与品种。凭据不在这里。
#
# 与 collector.env.example 的关系：这里只列覆盖项，其余走默认值。
# 容器内 `KCQ_DATA_ROOT` 由 docker-compose.yml 固定为 /data（挂载点），所以这里写的是宿主路径。

# 宿主数据目录（挂到容器的 /data）。
KCQ_DATA_ROOT_HOST=/volume1/kcq/analytics
# NAS 上的出网代理是另一个容器的发布端口；容器用 host 网络，所以是 127.0.0.1。
KCQ_PROXY_HOST=127.0.0.1
KCQ_PROXY_PORT=7891
KCQ_OPTION_INTERVAL=60
KCQ_VOLUME_INTERVAL=300
KCQ_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT
KCQ_CURRENCIES=BTC,ETH,SOL,BNB,XRP
